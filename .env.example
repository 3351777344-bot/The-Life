# Backend
PORT=3001

# OpenAI-compatible / BlueLM / Vivo
LLM_PROVIDER=openai-compatible
LLM_CHAT_COMPLETIONS_URL=https://api-ai.vivo.com.cn/v1/chat/completions
LLM_MODEL=your-model-name
LLM_ROUTE_MODEL=Doubao-Seed-2.0-mini
LLM_REQUEST_TIMEOUT_MS=60000
LLM_APP_ID=your-app-id
LLM_APP_KEY=your-api-key

# Optional media generation endpoints
IMAGE_GENERATE_URL=https://api-ai.vivo.com.cn/api/v1/image_generation
VIDEO_GENERATE_URL=https://api-ai.vivo.com.cn/api/v1/submit_task
VIDEO_QUERY_URL=https://api-ai.vivo.com.cn/api/v1/query_task
VIDEO_MODEL=Doubao-Seedance-1.0-pro
VIDEO_RATIO=16:9
VIDEO_DURATION_SECONDS=5

# Optional fallback for local Ollama
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/api
# OLLAMA_MODEL=llama3
